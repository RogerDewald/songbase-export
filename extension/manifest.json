{
  "manifest_version": 3,
  "name": "Songbase Export",
  "version": "0.1.0",
  "description": "Export songs from songbase.life to Word, plain text or PowerPoint — chords, verse numbers and choruses included.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Songbase Export",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "background": {
    "service_worker": "background/sw.js"
  },
  "permissions": ["sidePanel", "storage", "clipboardWrite", "downloads"],
  "host_permissions": ["https://songbase.life/*"],
  "content_scripts": [
    {
      "matches": ["https://songbase.life/*"],
      "js": ["content/extract.js", "content/content.js"],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Open Songbase Export"
    }
  }
}
